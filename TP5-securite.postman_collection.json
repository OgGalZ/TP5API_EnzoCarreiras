{
  "info": {
    "name": "TP5 - Securite API Spring Boot",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0a - Login user (recupere tokenUser)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.response.json().token;",
              "if (t) pm.collectionVariables.set('tokenUser', t);",
              "pm.test('Token recu', () => pm.expect(t).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "0b - Login admin (recupere tokenAdmin)",
      "request": {
        "method": "POST",
        "header": [
          {
