    {
      "name": "6 - Rate limit : lancer 6 fois en < 1 min -> 429",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "ApiKey 123456abcdef"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/utilisateurs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "utilisateurs"
          ]
        }
      }
    },
    {
      "name": "7 - Description avec <script> -> neutralisee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/utilisateurs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "utilisateurs"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Eve\",\n  \"email\": \"eve@example.com\",\n  \"description\": \"<script>alert('xss')</script>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));",
              "pm.test('Script neutralise', () => pm.expect(pm.response.json().description).to.not.include('<script>'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Requete en http:// -> redirection HTTPS",
      "request": {
