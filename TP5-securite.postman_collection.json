    {
      "name": "Bonus - Injection SQL dans la recherche -> 0 resultat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "pm.test('Aucun resultat', () => pm.expect(pm.response.json().length).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/utilisateurs/recherche?nom=' OR '1'='1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "utilisateurs",
            "recherche"
          ],
          "query": [
            {
              "key": "nom",
              "value": "' OR '1'='1"
            }
          ]
        }
      }
